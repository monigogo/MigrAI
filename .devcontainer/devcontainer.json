{
    "name": "MigrAI",

    "build": {
        "dockerfile": "Dockerfile"
    },

    "remoteUser": "vscode",

    "containerEnv": {
        "UV_SYSTEM_PYTHON": "1",
        "UV_PROJECT_ENVIRONMENT": "/usr/local"
    },

    "runArgs": ["--env-file", "${localWorkspaceFolder}/backend/.env"],

    "postCreateCommand": "cd /workspaces/migrAI/backend && uv sync --python /usr/local/bin/python3",

    "postAttachCommand": "cd /workspaces/migrAI/backend && uvicorn src.api.main:app --reload --host 0.0.0.0 --port 8000",

    "mounts": [
        "source=uv-cache,target=/home/vscode/.cache/uv,type=volume",
        "source=npm-cache,target=/home/vscode/.npm,type=volume"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "github.copilot",
                "charliermarsh.ruff",
                "dsznajder.es7-react-js-snippets",
                "esbenp.prettier-vscode"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python3",
                "python.analysis.extraPaths": ["./backend"],
                "python.terminal.activateEnvironment": false
            }
        }
    }
}