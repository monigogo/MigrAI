# ─── migrAI — Variables de Entorno (Desarrollo) ───────────────────
#
# En desarrollo, deja VITE_API_URL vacío para usar el proxy de Vite
# En producción, configura la URL completa de tu backend
#
# Ejemplo producción:
# VITE_API_URL=https://tu-backend.com
# ───────────────────────────────────────────────────────────────────

VITE_API_URL=http://127.0.0.1:8000
